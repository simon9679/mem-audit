# mem-audit reads endpoint keys from environment variables (never CLI flags, so
# they don't land in your shell history). The defaults use OpenAI for both the
# embedding pass and the LLM judge, so for most people a single OpenAI key is
# all that's needed:
OPENAI_API_KEY=

# Cerebras — used for --llm-provider cerebras, an OpenAI-compatible judge
# endpoint. Sign up: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# GitHub Models — used for --embed-provider github. NOTE: GitHub Models is being
# retired and its endpoint now returns HTTP 410 (retirement brownout), so this
# path is going away. Prefer OpenAI, or any other OpenAI-compatible embeddings
# endpoint via --embed-base-url. A token needs the 'models: read' permission:
# https://github.com/settings/tokens
GITHUB_TOKEN=
