# GitHub Models — used for --embed-provider github (one batched call per audit,
# so it's easy on the tight per-request quota). Needs a token with the
# 'models: read' permission: https://github.com/settings/tokens
GITHUB_TOKEN=

# Cerebras — used for --llm-provider cerebras (1M tokens/day free tier,
# no card). Sign up: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# Only needed if you use the OpenAI-direct providers instead (defaults).
OPENAI_API_KEY=
