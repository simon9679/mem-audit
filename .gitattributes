# Keep checksum manifests byte-stable for GNU sha256sum on Windows clones.
audit/results/MANIFEST.sha256 text eol=lf
audit/results/analysis_J4K4.json text eol=lf
audit/results/retrieval_J4K4.json text eol=lf
audit/results/analysis_HI.json text eol=lf
audit/results/analysis_H2I2.json text eol=lf

# The published adapter has a hash-pinned final CRLF byte sequence.
audit/compare_dumps.py -text

# Hash-pinned by file bytes in AUDIT_mem0.md §7. Without an eol pin a default
# Windows checkout rewrites these to CRLF and the published sha256 no longer
# matches — the failure that produced the duplicate hashes documented in §7.
audit/retrieval_questions.json text eol=lf
audit/symdiff_probe.py text eol=lf
audit/validate_symdiff_probe.py text eol=lf
audit/PROBE_symdiff_probe.md text eol=lf
audit/PROBE_symdiff_probe_v2.md text eol=lf
audit/PREREG_metric_entity_swap.md text eol=lf
audit/PROBE_symdiff_probe_REVIEW.md text eol=lf

# Canary redacted verdicts — hash-pinned by MANIFEST.sha256.
audit/canary/raw_redacted/** text eol=lf
audit/canary/raw_redacted/MANIFEST.sha256 text eol=lf
audit/canary/recompute_canary_ci.py text eol=lf
audit/canary/redact_canary.py text eol=lf
audit/canary/CANARY_FINAL.json text eol=lf
audit/canary/FINDING_canary_ci_mismatch.md text eol=lf

# Arena judge order-effect bundle — prereg, results, runner, manifest, and all
# 60 raw judgments are hash-pinned by audit/arena/run_balanced/MANIFEST.sha256.
# A default Windows checkout would rewrite these to CRLF and break the manifest.
audit/arena/** text eol=lf
audit/arena/run_balanced/MANIFEST.sha256 text eol=lf

# Arena bundle index and the summary-vs-raw finding — LF-pinned for stable review.
# (audit/arena/README.md is already covered by the glob above; pinned explicitly for parity.)
audit/arena/README.md text eol=lf
audit/FINDINGS_summary_vs_raw.md text eol=lf
